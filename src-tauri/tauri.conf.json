{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIMyChats",
  "version": "0.0.1",
  "identifier": "local.wechat.devifybridge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run stage:wxq",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AIMyChats",
        "width": 1360,
        "height": 900,
        "minWidth": 940,
        "minHeight": 640,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 24
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/image-cache/**"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "devify"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCMzg3MjBGMUU1MUE1NTMKUldSVHBWRWVEM0k0cTVwY3FSdW5XeFhaY2JkdFBMeDVrWmpjN2lCRkx6R1ZjL1dkaU1IRmM3MVIK",
      "endpoints": [
        "https://github.com/oneprolabs/devify-desktop/releases/download/alpha/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "resources": [
      "binaries/wxq-*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
