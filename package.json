{
  "name": "wechat-devify-bridge",
  "private": true,
  "version": "0.1.35",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "preview:menu": "vite --open /scripts/navigation-preview.html",
    "stage:aimychats-cli": "node scripts/stage-aimychats-cli.mjs --prepare && cargo build --release --bin aimychats-cli --features aux-binaries --manifest-path src-tauri/Cargo.toml && node scripts/stage-aimychats-cli.mjs",
    "tauri": "tauri",
    "test:frontend": "node scripts/test-frontend.mjs",
    "dev:app": "vite --mode development-app --port 1422 --strictPort",
    "build:dev": "tsc && vite build --mode development-app --outDir dist-dev",
    "stage:aimychats-cli:dev": "node scripts/stage-aimychats-cli.mjs --prepare --dev && cargo build --release --bin aimychats-cli --features aux-binaries,dev-app --manifest-path src-tauri/Cargo.toml && node scripts/stage-aimychats-cli.mjs --dev",
    "desktop:dev": "tauri dev --config src-tauri/tauri.dev-app.conf.json",
    "desktop:build:dev": "bash scripts/macos-build.sh --dev --no-install",
    "desktop:install:dev": "bash scripts/macos-build.sh --dev"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-deep-link": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
